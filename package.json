{
  "name": "vakao-mascot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny, dependency-free bottom-right mascot Web Component with React and Vue bindings.",
  "license": "MIT",
  "author": "Rouarn <2937375029@qq.com> (https://github.com/Rouarn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rouarn/vakao-mascot.git"
  },
  "homepage": "https://github.com/Rouarn/vakao-mascot#readme",
  "bugs": {
    "url": "https://github.com/Rouarn/vakao-mascot/issues"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "build:examples": "pnpm -r --filter \"./examples/**\" run build",
    "dev:vanilla": "pnpm --filter @vakao/mascot-example-vanilla run dev",
    "dev:react": "pnpm --filter @vakao/mascot-example-react run dev",
    "dev:vue": "pnpm --filter @vakao/mascot-example-vue run dev"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
